FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me-too
JWT_COOKIE_SECURE=true
JWT_COOKIE_SAMESITE=Lax
FRONTEND_ORIGIN=http://localhost:3000,http://localhost:5173
RATELIMIT_STORAGE_URI=memory://
PROJECT_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=change-me
SUPABASE_BUCKET_NAME=secure-uploads

# Email (see app/services/email.py / config.py). sandbox.smtp.mailtrap.io:2525
# is Mailtrap's public Email Testing endpoint -- create a free inbox at
# mailtrap.io and fill in that inbox's own username/password here.
MAIL_SERVER=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USE_TLS=true
MAIL_USERNAME=change-me
MAIL_PASSWORD=change-me
MAIL_DEFAULT_SENDER=SmartBatch <no-reply@smartbatch.test>
MAIL_SUPPRESS_SEND=false

# Resend (see app/services/resend_email_service.py) -- preferred over MAIL_*
# above whenever set (see get_email_service()). Needed in production: Render
# blocks/restricts outbound raw SMTP, so MAIL_* alone won't deliver there.
# Get a key at resend.com; RESEND_FROM_EMAIL defaults to their shared sandbox
# domain, which only delivers to the email that created the Resend account
# until you verify a real domain in their dashboard.
RESEND_API_KEY=change-me
RESEND_FROM_EMAIL=SmartBatch <onboarding@resend.dev>

# Razorpay (see app/services/razorpay_service.py). RAZORPAY_WEBHOOK_SECRET is
# configured separately in the Razorpay dashboard's webhook settings -- it is
# NOT the same value as RAZORPAY_KEY_SECRET.
RAZORPAY_KEY_ID=change-me
RAZORPAY_KEY_SECRET=change-me
RAZORPAY_WEBHOOK_SECRET=change-me

# Fee billing calendar (see config.py) -- defaults are usually fine.
FEE_GENERATION_DAY_OF_MONTH=25
FEE_DUE_DAY_OF_MONTH=10